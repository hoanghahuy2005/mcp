# Mock mode is the safe default. Copy to .env only for local use; .env is ignored.
PROJEQTOR_MODE=mock
ENABLE_WRITE=false
ENABLE_REAL_WRITE=false
MCP_TRANSPORT=http
MCP_AUTH_MODE=legacy
MCP_BEARER_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS

# Real reads/writes (uncomment and fill only in a controlled environment).
# PROJEQTOR_BASE_URL=http://localhost:8080/projeqtor/api/
# PROJEQTOR_USERNAME=writer
# PROJEQTOR_PASSWORD=REPLACE_WITH_SECRET
# PROJEQTOR_API_KEY=REPLACE_WITH_THE_SAME_USERS_32_HEX_API_KEY
# PROJEQTOR_AES_KEY_LENGTH=256
# ENABLE_WRITE=true
# ENABLE_REAL_WRITE=true
